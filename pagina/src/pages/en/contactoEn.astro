  <section class="max-w-4xl mx-auto px-4 pb-20 grid gap-6">

    <ContactCardEn
      src="/whatsapp.png"
      title="WhatsApp"
      description="Text me on WhatsApp"
      link="https://wa.me/542475407723"
    />

    <ContactCardEn
      src="/gmail.png"
      title="Email"
      description="Send me an email"
      link="https://mail.google.com/mail/u/0/#inbox?compose=DmwnWrRnXmnkfpdFjrFdwkHhQGHHHkMkckXjTjclfrTsnCHPjjSqQbxDPdhdgXsJbWqGJjSzJfqv"
    />
  </section>
</Layout>
<FooterEn />