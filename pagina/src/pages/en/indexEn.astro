---
import Layout from "../../layouts/Layout.astro";
import NavbarEn from "../../components/en/NavbarEn.astro";
import AboutEn from "../../components/en/AboutEn.astro";
import ProjectsEn from "../../components/en/ProjectsEn.astro";
import FooterEn from "../../components/en/FooterEn.astro";
---

<Layout title="Mi Portfolio">

<NavbarEn />
  <section class="page-hero home-hero min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-5xl mx-auto flex flex-col-reverse md:flex-row items-center justify-center gap-8 md:gap-14 text-center md:text-left">
      <div class="max-w-2xl">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4">
          Hi, I'm Benja 👋
        </h1>

        <p class="text-zinc-400 text-xl">
          Software Developer
        </p>
      </div>

      <div
        class="w-48 h-48 sm:w-56 sm:h-56 md:w-64 md:h-64 shrink-0 rounded-full border border-white/15 shadow-2xl shadow-cyan-950/40 bg-center bg-cover"
        style="background-image: url('/1790602277535.jpg'), linear-gradient(135deg, #27272a, #18181b 55%, #164e63);"
        role="img"
        aria-label="Profile picture"
      ></div>
  </section>
<AboutEn />

<ProjectsEn />
    <div class="max-w-5xl mx-auto px-6">
      <a href="/en/proyectosEn" class="mt-8 bg-white text-black px-6 py-3 rounded-xl font-bold hover:scale-105 transition">
        View more details
      </a>
    </div>

  <section class="min-h-screen flex items-center px-6">
    <section class="relative min-h-screen flex items-center px-6"></section>
    <div class="max-w-5xl mx-auto">
    <div class="absolute top-0 left-0 w-96 h-96 bg-purple-500/30 blur-[120px]"></div>

      <p class="text-purple-400 mb-4">
        Developer
      </p>

      <h1 class="text-6xl md:text-8xl font-black leading-none mb-6">
        I create modern digital experiences.
      </h1>

      <p class="text-zinc-400 text-xl max-w-2xl">
        I develop modern web applications focused on design,
        performance and user experience.
      </p>

      <a href="/en/contactoEn" class="inline-block mt-8 bg-white text-black px-6 py-3 rounded-xl font-bold hover:scale-105 transition">
        Contact
      </a>

    </div>

  </section>
<FooterEn />
</Layout>
<style>
  .home-hero::before {
    inset: 12% 8%;
  }

  @media (max-width: 767px) {
    .home-hero::before {
      inset: 8% 4%;
    }
  }
</style>