---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
---

<Layout title="Mi Portfolio">

<Navbar />
    <section class="min-h-screen flex items-center justify-center">
      <div class="text-center">

        <h1 class="text-6xl font-bold mb-4">
          Hola, soy Benja 👋
        </h1>

        <p class="text-zinc-400 text-xl">
          Desarrollador de Software
        </p>

      </div>
    </section>
  <About />

  <Projects />
  <div class="max-w-6xl mx-auto">
  <a href="/proyectos" class="mt-8 bg-white text-black px-6 py-3 rounded-xl font-bold hover:scale-105 transition">
    Ver mas detalles
  </a>
  </div>

  <section class="min-h-screen flex items-center px-6">
    <section class="relative min-h-screen flex items-center px-6"></section>
    <div class="max-w-5xl mx-auto">
    <div class="absolute top-0 left-0 w-96 h-96 bg-purple-500/30 blur-[120px]"></div>

      <p class="text-purple-400 mb-4">
        Developer
      </p>

      <h1 class="text-6xl md:text-8xl font-black leading-none mb-6">
        Creo experiencias digitales modernas.
      </h1>

      <p class="text-zinc-400 text-xl max-w-2xl">
        Desarrollo aplicaciones web modernas enfocadas en diseño,
        performance y experiencia de usuario.
      </p>

        <button class="mt-8 bg-white text-black px-6 py-3 rounded-xl font-bold hover:scale-105 transition">
          Contacto
          <a href="/contacto" class="absolute inset-0"></a>
        </button>

    </div>

  </section>
