---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Mi Portfolio">

<Navbar />
  <section class="page-hero home-hero min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-5xl mx-auto flex flex-col-reverse md:flex-row items-center justify-center gap-8 md:gap-14 text-center md:text-left">
      <div class="max-w-2xl">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4">
          Hola, soy Benja 👋
        </h1>

        <p class="text-zinc-400 text-xl">
          Desarrollador de Software
        </p>
      </div>

      <div
        class="w-48 h-48 sm:w-56 sm:h-56 md:w-64 md:h-64 shrink-0 rounded-full border border-white/15 shadow-2xl shadow-cyan-950/40 bg-center bg-cover"
        style="background-image: url('/1790602277535.jpg'), linear-gradient(135deg, #27272a, #18181b 55%, #164e63);"
        role="img"
        aria-label="Foto de perfil"
      ></div>
  </section>
<About />

<Projects />
  <div class="max-w-5xl mx-auto px-6">
    <a href="/proyectos" class="mt-8 bg-white text-black px-6 py-3 rounded-xl font-bold hover:scale-105 transition">
      Ver mas detalles
    </a>
  </div>

  <section class="min-h-screen flex items-center px-6">
    <section class="relative min-h-screen flex items-center px-6"></section>
    <div class="max-w-5xl mx-auto">
    <div class="absolute top-0 left-0 w-96 h-96 bg-purple-500/30 blur-[120px]"></div>

      <p class="text-purple-400 mb-4">
        Developer
      </p>

      <h1 class="text-6xl md:text-8xl font-black leading-none mb-6">
        Creo experiencias digitales modernas.
      </h1>

      <p class="text-zinc-400 text-xl max-w-2xl">
        Desarrollo aplicaciones web modernas enfocadas en diseño,
        performance y experiencia de usuario.
      </p>

      <a href="/contacto" class="inline-block mt-8 bg-white text-black px-6 py-3 rounded-xl font-bold hover:scale-105 transition">
        Contacto
      </a>

    </div>

  </section>
<Footer />
</Layout>

<style>
  .home-hero::before {
    inset: 12% 8%;
  }

  @media (max-width: 767px) {
    .home-hero::before {
      inset: 8% 4%;
    }
  }
</style>