---
const { title, description } = Astro.props;
---

<div class="bg-zinc-900 border border-white/10 rounded-3xl p-6 hover:-translate-y-2 transition duration-300">

  <div class="h-48 bg-zinc-800 rounded-2xl mb-6"></div>

  <h3 class="text-2xl font-bold mb-3">
    {title}
  </h3>

  <p class="text-zinc-400">
    {description}
  </p>

</div>