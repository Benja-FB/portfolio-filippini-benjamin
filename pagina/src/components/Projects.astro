---
import ProjectCard from "./Projectcard.astro";
---

<section class="py-10 px-6">

  <div class="max-w-5xl mx-auto px-6">

    <p class="text-purple-400 mb-4">
      Proyectos
    </p>

    <h2 class="text-5xl font-bold mb-16">
      Algunos trabajos recientes.
    </h2>

    <div class="grid md:grid-cols-2 gap-8">

      <ProjectCard
        src = "/public/negocio.ico"
        title="Proyecto de Negocios"
        description="Aplicación para ver los productos locales de los negocios."
      />

      <ProjectCard
        src = "/public/delivery.ico"
        title="Proyecto de Delivery"
        description="Aplicación para contratar servicios de delivery."
      />

    </div>
  </div>
</section>