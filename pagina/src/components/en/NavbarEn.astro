    <details class="relative group">
      <summary
        class="list-none cursor-pointer p-2 rounded-lg hover:bg-zinc-800 transition flex items-center gap-1"
        aria-label="Cambiar idioma"
      >
        <img
          src="/traduccionlogo.png"
          alt=""
          class="theme-language-icon w-6 h-6"
        />
        <span class="text-xs transition-transform duration-200 group-open:rotate-180" aria-hidden="true">⌄</span>
      </summary>

      <div class="absolute top-full mt-3 right-0 bg-zinc-900 border border-zinc-800 rounded-lg p-2 min-w-32 shadow-xl">
        <a
