---
const { src, title, description, link } = Astro.props;
---

<a 
  href={link} 
  target="_blank" 
  rel="noopener noreferrer"
  class="block"
>
  <div class="flex items-center gap-5 p-5 bg-zinc-900/60 backdrop-blur rounded-2xl border border-zinc-800 hover:border-purple-500 hover:scale-[1.02] transition cursor-pointer">

    <img 
      src={src} 
      alt={title}
      class="w-12 h-12 object-contain"
    />

    <div>
      <h2 class="text-lg font-bold">{title}</h2>
      <p class="text-gray-400 text-sm">{description}</p>
    </div>

  </div>
</a>