---
import '../styles/global.css'
const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body class="bg-zinc-950 text-white overflow-x-hidden">
    <slot />
  </body>
</html>